{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "lib/**",
        ".angular/**"
      ],
      "env": [
        "NG_APP_API_URL",
        "NG_APP_ENV",
        "API_BASE_URL",
        "PUBLIC_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "FIRESTORE_EMULATOR_HOST",
        "JEST_WORKER_ID"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "license-check": {
      "dependsOn": []
    },
    "secret-check": {
      "dependsOn": []
    },
    "audit:fix": {
      "dependsOn": []
    }
  }
}