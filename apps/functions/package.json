{
  "name": "functions",
  "version": "1.34.2",
  "description": "Cloud Functions for Firebase",
  "author": "AKINA",
  "license": "MIT",
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsc --watch",
    "test": "jest --coverage",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "setup:scheduler": "npx ts-node scripts/setup-scheduler.ts",
    "license-check": "license-checker --summary --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC-BY-4.0;BlueOak-1.0.0;CC-BY-3.0;CC0-1.0;Unlicense;0BSD\"",
    "secret-check": "secretlint \"**/*\"",
    "audit:fix": "npm audit fix"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@xdevplatform/xdk": "^0.6.6",
    "dotenv": "^18.0.8",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0",
    "ts-deepmerge": "^8.0.0",
    "brace-expansion": "^2.1.7",
    "fast-uri": "^3.1.9",
    "@grpc/grpc-js": "^1.14.6",
    "ip-address": "^10.7.4",
    "proxy-addr": "^2.0.8",
    "@fastify/busboy": "^3.2.4"
  }
}
