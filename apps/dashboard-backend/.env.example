# -----------------------------------------------------------------------------
# Rebecca AI Admin Dashboard BFF - Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env for local development and CLI scripts.
# Do NOT commit your actual .env file.
# -----------------------------------------------------------------------------

# Port for the Express server to listen on
PORT=8081

# Google Cloud Platform Project ID
GCP_PROJECT_ID=rebecca-ai-gal

# Location for GCP resources
GCP_LOCATION=asia-northeast1

# Google Cloud Storage bucket for image assets
IMAGE_BUCKET_NAME=rebecca-ai-gal-images

# Gemini API Key for Copilot and other AI features
GEMINI_API_KEY=your-gemini-api-key

# Public Website URL (where "Go to Public Site" redirects)
PUBLIC_SITE_URL=https://rebecca-ai.net

# Firebase Web Client Public Identifiers (served dynamically to frontend via /api/v1/config)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_WEB_APP_ID=your-firebase-web-app-id

# Local Admin CLI Provisioning (for `npm run register-admin`)
# Optional: Set service account JSON path if Application Default Credentials (ADC) are not configured.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ADMIN_EMAIL=admin@example.com
# ADMIN_ROLE=SUPER_ADMIN

# Optional: gRPC host for bot-backend (Default: localhost:50051)
BOT_GRPC_HOST=localhost:50051

# Firestore Emulator configuration (Optional: for local testing only)
# FIRESTORE_EMULATOR_HOST="localhost:8080"
# NO_AUTH=true

# CORS Configuration
# Comma-separated list of allowed origins for frontend dashboard
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-dashboard-app.web.app

