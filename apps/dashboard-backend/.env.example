# -----------------------------------------------------------------------------
# Rebecca AI Admin Dashboard BFF - Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env or .env.local for local development.
# Do NOT commit your actual .env file.
# -----------------------------------------------------------------------------

# Port for the Express server to listen on
PORT=8081

# Google Cloud Platform Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Location for GCP resources (e.g., Cloud Tasks)
GCP_LOCATION=asia-northeast1

# Google Cloud Storage bucket for image assets
IMAGE_BUCKET_NAME=rebecca-ai-gal-images

# Gemini API Key for Copilot and other AI features
GEMINI_API_KEY=your-gemini-api-key

# Firestore Emulator configuration (Optional: for local testing only)
# If set, the Firebase Admin SDK will automatically connect to the local emulator
FIRESTORE_EMULATOR_HOST="localhost:8080"
