{
  "name": "dashboard-backend",
  "version": "1.0.0",
  "description": "Backend-for-Frontend (BFF) for the Admin Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "license-check": "license-checker --summary --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC-BY-4.0;BlueOak-1.0.0;CC-BY-3.0;CC0-1.0;Unlicense;UNLICENSED;0BSD\"",
    "secret-check": "secretlint \"**/*\"",
    "audit:fix": "npm audit fix"
  },
  "keywords": [
    "rebecca",
    "dashboard",
    "bff"
  ],
  "author": "AKINA",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "@rebecca/db": "*",
    "@rebecca/types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.1.0",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.63.0"
  }
}
