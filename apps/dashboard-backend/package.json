{
  "name": "dashboard-backend",
  "version": "1.7.8",
  "description": "Backend-for-Frontend (BFF) for the Admin Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --files src/index.ts",
    "test": "jest --passWithNoTests --coverage",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "register-admin": "ts-node scripts/register-admin.ts",
    "license-check": "license-checker --summary --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC-BY-4.0;BlueOak-1.0.0;CC-BY-3.0;CC0-1.0;Unlicense;0BSD\"",
    "secret-check": "secretlint \"**/*\"",
    "audit:fix": "npm audit fix"
  },
  "keywords": [
    "rebecca",
    "dashboard",
    "bff"
  ],
  "author": "AKINA",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/tasks": "^7.0.0",
    "@google/genai": "^2.19.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@rebecca/db": "*",
    "@rebecca/persona": "*",
    "@rebecca/types": "*",
    "@xdevplatform/xdk": "^0.6.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.2.0",
    "helmet": "^8.0.0",
    "luxon": "^3.7.2",
    "multer": "^2.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
