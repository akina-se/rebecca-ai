{
  "name": "dashboard-backend",
  "version": "1.0.0",
  "description": "Backend-for-Frontend (BFF) for the Admin Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev src/index.ts",
    "test": "jest --passWithNoTests --coverage",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "license-check": "license-checker --summary --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC-BY-4.0;BlueOak-1.0.0;CC-BY-3.0;CC0-1.0;Unlicense;0BSD\"",
    "secret-check": "secretlint \"**/*\"",
    "audit:fix": "npm audit fix"
  },
  "keywords": [
    "rebecca",
    "dashboard",
    "bff"
  ],
  "author": "AKINA",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "@google-cloud/storage": "^7.21.0",
    "@google-cloud/tasks": "^6.2.3",
    "@google/genai": "^2.10.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@rebecca/db": "*",
    "@rebecca/persona": "*",
    "@rebecca/types": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^12.1.0",
    "helmet": "^8.0.0",
    "luxon": "^3.7.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/luxon": "^3.7.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.63.0"
  }
