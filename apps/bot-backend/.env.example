# Server
# Port for the Express server to listen on.
PORT=8080
# Application Timezone
# Standard IANA Time Zone Database identifier (RFC 6557 / ECMA-402 standard).
# Used for time-of-day greeting context in soliloquy posts and cron scheduling.
# Examples: 'Asia/Tokyo' (Japan), 'America/New_York' (US Eastern), 'Europe/London' (UK), 'UTC'
# Reference: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Default: Asia/Tokyo
APP_TIMEZONE=Asia/Tokyo

# GCP (Google Cloud Platform) Settings
# Project ID where Cloud Run, Firestore, and GCS reside.
GCP_PROJECT_ID=your-gcp-project-id
# Location/Region for GCP resources (e.g., asia-northeast1).
GCP_LOCATION=asia-northeast1
# Name of the Cloud Tasks queue for delayed execution.
GCP_TASK_QUEUE_NAME=rebecca-reply-queue
# URL for the Cloud Run worker endpoint (to be set after deployment).
WORKER_URL=https://your-cloud-run-service-url.a.run.app
# GCS Bucket name where uploaded images are stored for proactive timeline posts.
IMAGE_BUCKET_NAME=rebecca-ai-gal-images

# X API (Free Plan or higher required)
# App Key (Consumer Key) from X Developer Portal.
X_API_KEY=
# App Secret (Consumer Secret) from X Developer Portal.
X_API_SECRET=
# Access Token for the bot account.
X_ACCESS_TOKEN=
# Access Secret for the bot account.
X_ACCESS_SECRET=
# The numerical Twitter User ID of this bot account (used to ignore self-mentions).
X_MY_USER_ID=your-bot-twitter-user-id

# Gemini API
# API Key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
# Model used for main conversation generation and text summarization.
GEMINI_MODEL=gemini-3.5-flash-lite
# Model used for safety auditing (LLM-as-a-Judge) and image relevance verification.
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
# Model used for language detection.
GEMINI_LANGUAGE_MODEL=gemini-3.1-flash-lite
# (Optional) Model used for vector search embeddings (Default: gemini-embedding-2)
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
# Model used for Vision tasks (e.g., extracting descriptive captions from uploaded images).
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Model used to infer emotional keywords from timeline summaries for image matching.
GEMINI_IMAGE_INFERENCE_MODEL=gemini-3.5-flash-lite
# Model used for proactive news search with Google Search Grounding.
GEMINI_NEWS_SEARCH_MODEL=gemini-2.5-flash
# Model used for structuring proactive news tweets (lightweight Gemma model).
GEMINI_NEWS_POST_MODEL=gemini-3.5-flash-lite
# Sampling temperature for Gemini text generation (Default: 1.20).
GEMINI_TEMPERATURE=1.20
# Nucleus sampling probability for Gemini text generation (Default: 0.95).
GEMINI_TOP_P=0.95
# Thinking level for Gemini generation: MINIMAL, LOW, MEDIUM, or HIGH (Default: MEDIUM).
GEMINI_THINKING_LEVEL=MEDIUM

# Logs & RAG & Images
# Number of days to retain raw conversation logs before deletion.
LOG_RETENTION_DAYS=180
# Maximum number of episodic memories to store per user in Firestore.
RAG_MAX_MEMORIES=100
# The number of days an image must wait (cooldown) before it can be used again.
IMAGE_COOLDOWN_DAYS=3
# Number of days to look back for conversation logs during memory evolution.
EVOLUTION_LOOKBACK_DAYS=7

# Mentions Polling Interval (minutes)
# Recommended to set to 60 or higher to avoid unexpected charges on Pay-As-You-Go plans.
# * Used when running locally without Cloud Scheduler.
POLLING_INTERVAL_MINUTES=60

# Rate Limits
# Global daily maximum number of requests (budget limit for LLM API).
GLOBAL_DAILY_LIMIT=500
# Maximum number of replies per day per user (enforces strict quota per user).
USER_DAILY_LIMIT=5
# Maximum number of requests per minute per user (Spam prevention).
SPAM_MINUTE_LIMIT=3
# Rate limit for public endpoints per IP address (requests per 15 minutes).
PUBLIC_IP_RATE_LIMIT=100

# Auth Configuration
# A shared secret used as a fallback to authenticate requests to /batch endpoints when Cloud Scheduler OIDC is not used.
# Note: When NODE_ENV=production, this variable is ignored (forced to undefined) to enforce Google OIDC authentication and prevent credential-downgrade attacks.
BATCH_SECRET_KEY=your_secret_key_here
# OIDC Audience for authenticating Cloud Scheduler and Cloud Tasks requests. Usually your Cloud Run service URL.
OIDC_EXPECTED_AUDIENCE=https://your-cloud-run-service-url.a.run.app
# OIDC Issuer for Google Cloud OIDC tokens.
OIDC_EXPECTED_ISSUER=https://accounts.google.com
# Service Account Email used by Cloud Scheduler to sign OIDC tokens for authenticating calls to Cloud Run /batch endpoints.
# Required when running `npm run setup:scheduler` to configure OIDC on production Cloud Scheduler jobs.
SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project-id.iam.gserviceaccount.com

# X Target List ID
# The numeric ID of the X List used for stealth onboarding (following without actually following).
X_TARGET_LIST_ID=your_list_id_here

# X Followers Max Results
# The maximum number of followers to fetch in one request (up to 1000 for X API v2).
X_FOLLOWERS_MAX_RESULTS=1000
FIRESTORE_EMULATOR_HOST="localhost:8080"



# Proactive News Deduplication
# Number of days to look back in timeline_history to deterministically exclude duplicate news topics.
# Default: 30
NEWS_DEDUP_LOOKBACK_DAYS=30
# Cosine similarity threshold (0.0 - 1.0) above which a headline is considered a duplicate.
# Default: 0.82
NEWS_DEDUP_SIMILARITY_THRESHOLD=0.82

# Active Persona Configuration
# Specifies the active persona identifier (defaults to 'rebecca').
ACTIVE_PERSONA=rebecca

# Allowed Image Domains Configuration
# Comma-separated list of allowed domains/suffixes for downloading media attachments (defaults to twimg.com,twitter.com,x.com).
ALLOWED_IMAGE_DOMAINS=twimg.com,twitter.com,x.com

# Interactive X Poll Configuration
# Voting duration in minutes for X polls (X API v2 range: 5 to 10080 minutes; default: 1380 = 23 hours).
POLL_DURATION_MINUTES=1380


# Supporter Appreciation & Tipping System (Stripe)
# Public portal Special Thanks URL embedded in Rebecca's appreciation tweets
SUPPORT_OFFICIAL_PORTAL_URL="https://rebecca-ai.net/supporters#plans"
# Fallback display name for supporters when the submitted name is blank, contains @/URLs/#, or exceeds length
SUPPORT_FALLBACK_NAME=名無しのマスター
# Maximum character length for supporter display names (default: 20)
SUPPORT_MAX_NAME_LENGTH=20
# Stripe API Secret Key (e.g., sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=
# Stripe Webhook Signing Secret for verifying checkout.session.completed events (e.g., whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe Public Payment Links for Supporter Tiers (Test mode buy.stripe.com/test_... or Live mode buy.stripe.com/...)
STRIPE_PAYMENT_LINK_BRONZE=https://buy.stripe.com/test_bronze_energy_drink
STRIPE_PAYMENT_LINK_SILVER=https://buy.stripe.com/test_silver_server_resource
STRIPE_PAYMENT_LINK_GOLD=https://buy.stripe.com/test_gold_dev_support
# Public contact email displayed on Tokushoho (Legal) notice and support queries
SUPPORT_CONTACT_EMAIL=contact@example.com
