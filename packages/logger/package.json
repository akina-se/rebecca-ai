{
  "name": "@rebecca/logger",
  "version": "1.25.0",
  "description": "Shared structured logger for Google Cloud Logging and Cloud Error Reporting",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
