{
  "name": "rebecca-ai-gal-monorepo",
  "version": "1.7.6",
  "description": "",
  "author": "AKINA",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=!dashboard-e2e",
    "test:e2e": "npm run test --workspace=dashboard-e2e",
    "test:coverage-summary": "node scripts/ci-coverage-summary.js",
    "deploy:hosting": "npm run build --workspace=dashboard-frontend && npx --yes firebase-tools@latest deploy --only hosting --project rebecca-ai-gal",
    "license-check": "turbo run license-check",
    "secret-check": "turbo run secret-check",
    "register-admin": "npm run register-admin --workspace=dashboard-backend --",
    "audit:fix": "npm audit fix"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.1",
    "jest": "^30.4.2",
    "license-checker": "^25.0.1",
    "secretlint": "^13.0.2",
    "ts-jest": "^29.2.0",
    "turbo": "latest",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "micromatch": "^4.0.8",
    "brace-expansion": "^2.0.2",
    "tmp": "^0.2.6",
    "tar": "^7.5.3",
    "rollup": "^4.59.0",
    "postcss": "^8.5.3",
    "piscina": "^4.8.2",
    "http-proxy-middleware": "^3.0.3",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "vite": "^5.4.14",
    "esbuild": "^0.25.0",
    "webpack": "^5.98.0",
    "webpack-dev-server": "^5.2.0",
    "ts-deepmerge": "^8.0.0",
    "picomatch": "^4.0.2"
  }
}
